@page "/todo"
@using WebApp2.Components
@using Shared
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Todo</PageTitle>

<TimeComponent/>


<h1>Todo (not done: @todos.Count(todo => !todo.IsDone))</h1>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Status</th>
        <th>Title</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var todo in todos)
    {
        <tr>
            <td>
                <InputCheckbox @bind-Value="todo.IsDone" @onchange="async () => await UpdateTodo(todo)" />
            </td>
            <td>@todo.Title</td>
            <td>
                <button class="btn btn-danger" @onclick="() => RemoveToDo(todo)">X</button>
            </td>
        </tr>
    }
    </tbody>
</table>
<button onclick="@Open">ADD</button>

<ModalDialog @ref="@addDialog" Title="TILFØJ">
    <InputText @bind-value="newTodo" placeholder="Indtast ny to-do" />
    <button class="btn btn-primary" @onclick="() => AddTodo()">Add</button>
</ModalDialog>

<InputText placeholder="Something todo" @bind-Value="newTodo" />
<button @onclick="AddTodo">Add todo</button>

@code {
    private string? newTodo;
    private List<BETodoItem> todos = new();
    private ModalDialog? addDialog { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTodos();
    }

    private async Task LoadTodos()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<BETodoItem>>("http://localhost:5299/api/todo");
            if (response != null)
            {
                todos = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading todos: {ex.Message}");
        }
    }

    private async Task AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(newTodo))
        {
            var todoItem = new BETodoItem { Title = newTodo, IsDone = false };
            try
            {
                var response = await Http.PostAsJsonAsync("http://localhost:5299/api/todo", todoItem);
                if (response.IsSuccessStatusCode)
                {
                    await LoadTodos();
                    newTodo = string.Empty;
                    addDialog?.Close();
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error adding todo: {ex.Message}");
            }
        }
    }

    private async Task UpdateTodo(BETodoItem todo)
    {
        try
        {
            var response = await Http.PutAsJsonAsync("http://localhost:5299/api/todo", todo);
            if (!response.IsSuccessStatusCode)
            {
                await LoadTodos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating todo: {ex.Message}");
            await LoadTodos();
        }
    }

    private async Task RemoveToDo(BETodoItem todo)
    {
        try
        {
            var response = await Http.DeleteAsync($"/api/todo/{Uri.EscapeDataString(todo.Title)}");
            if (response.IsSuccessStatusCode)
            {
                await LoadTodos();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error removing todo: {ex.Message}");
        }
    }

    private void Open()
    {
        addDialog?.Open();
    }
}